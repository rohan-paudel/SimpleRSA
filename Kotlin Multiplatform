    suspend fun encryptMessage(
        message: String, e: Long = this.e, n: Long = this.n, blockSize: Int = 1
    ): List<Long> = coroutineScope {
        message.chunked(blockSize).map { block ->
            async {
                val combinedValue = block.fold(0L) { acc, char ->
                    acc * 256 + char.code.toLong()
                }
                combinedValue.modPow(e, n)
            }
        }.awaitAll()
    }
    
    fun encryptMessageOld(message: String): List<Long> {
        val encryptedMessage = mutableListOf<Long>()

        for (char in message) {
            val m = char.code.toLong()
            val cipher = m.modPow(e, n)
            encryptedMessage.add(cipher)
        }
        return encryptedMessage
    }

    suspend fun decryptMessage(
        encryptedBlocks: List<Long>,
        d: Long = this.d,
        n: Long = this.n,
        blockSize: Int = 1
    ): String = coroutineScope {
        encryptedBlocks.chunked(blockSize).map { blockChunk ->
            async {
                blockChunk.joinToString("") { encryptedBlock ->
                    val decryptedValue = encryptedBlock.modPow(d, n)

                    var value = decryptedValue
                    val decodedBlock = StringBuilder()

                    while (value > 0L) {
                        val charCode = (value % 256).toInt()
                        decodedBlock.insert(0, charCode.toChar())
                        value /= 256
                    }

                    decodedBlock.toString()
                }
            }
        }.awaitAll().joinToString("")
    }

    fun decryptMessageOld(encryptedMessage: List<Long>): String {
        val decryptedMessage = StringBuilder()

        for (cipher in encryptedMessage) {
            val m = cipher.modPow(d, n)
            decryptedMessage.append(m.toInt().toChar())
        }

        return decryptedMessage.toString()
    }

    private fun calculateEOld(phi: Long): Long {
        val coPrimeList = mutableListOf<Long>()
        var i = 1L

        while (i < phi) {
            if (gcdOld(phi, i) == 1L) {
                coPrimeList.add(i)
            }
            i += 1L
        }
        val e = coPrimeList.random()
        return e
    }

    private fun gcdOld(a: Long, b: Long): Long {
        return if (b == 0L) a else gcdOld(b, a % b)
    }


    private fun calculateDOld(e: Long, phi: Long): Long {
        var t = 0L
        var newT = 1L
        var r = phi
        var newR = e

        while (newR != 0L) {
            val quotient = r / newR

            val tempT = t
            t = newT
            newT = tempT - quotient * newT

            val tempR = r
            r = newR
            newR = tempR - quotient * newR
        }

        if (r > 1L) throw Exception("e is not invertible")
        if (t < 0L) t += phi

        return t
    }

    private fun calculateE(phi: Long): Long {
        var e: Long
        do {
            e = Random.nextLong(2, phi - 1)
        } while (gcd(phi, e) != 1L)
        return e
    }

    private fun gcd(a: Long, b: Long): Long {
        var x = a
        var y = b
        while (y != 0L) {
            val temp = y
            y = x % y
            x = temp
        }
        return x
    }

    private fun calculateD(e: Long, phi: Long): Long {
