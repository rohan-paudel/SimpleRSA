fun Long.modPow(exponent: Long, modulus: Long): Long {
    var result = 1L
    var base = this % modulus
    var exp = exponent

    while (exp > 0) {
        if (exp % 2 == 1L) {
            result = (result * base) % modulus
        }
        base = (base * base) % modulus
        exp /= 2
    }

    return result
}
